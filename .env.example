# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Required. Any long random string for local use. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# 1 for local development, 0 (or unset) for anything public.
DEBUG=1

# Comma-separated host names. Required when DEBUG is 0.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins with scheme, e.g. https://staging.example.com
CSRF_TRUSTED_ORIGINS=

SHOP_NAME=Hardware Store

# Database. With Docker Compose, POSTGRES_HOST is set to "db" for you.
POSTGRES_DB=hardware
POSTGRES_USER=hardware
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
